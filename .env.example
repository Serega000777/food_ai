# Copy to .env and fill in real values for local development.
# Never commit a real .env — see .gitignore.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_ai
CORS_ORIGIN=*
TELEGRAM_BOT_TOKEN=
JWT_ACCESS_SECRET=

# Read by apps/miniapp (Vite) — where the Mini App calls the API.
VITE_API_URL=http://localhost:3000

# Photo upload / AI queue (ADR 0011, ADR 0012, ADR 0013).
# Matches `pnpm docker:up`'s local MinIO — change only for a non-local bucket.
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=food-ai-meal-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
AI_PROVIDER_PRIMARY=mock
# Required only when AI_PROVIDER_PRIMARY=gemini (ADR 0014). Get a free-tier key at
# https://aistudio.google.com/apikey — never commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# If Google's API is only reachable through a local proxy/VPN on your machine, Node's
# fetch ignores HTTP_PROXY/HTTPS_PROXY by default — export NODE_USE_ENV_PROXY=1
# alongside them before running the API for Gemini calls to actually go through it.
